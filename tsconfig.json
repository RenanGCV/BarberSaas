{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@barbersaas/shared": ["./packages/shared/src"],
      "@barbersaas/ui": ["./packages/ui/src"],
      "@barbersaas/config": ["./packages/config/src"]
    }
  },
  "exclude": ["node_modules", "dist", "build"]
}
